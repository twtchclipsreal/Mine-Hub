-- FONT (Minecraft.ttf if possible, else Arcade pixel font)
-- =========================================================
local customFont
pcall(function()
	if writefile and isfile and getcustomasset and isfile("Minecraft.ttf") then
		writefile("NovaMinecraft.json", HttpService:JSONEncode({
			name = "Minecraft",
			faces = { { name = "Regular", weight = 400, style = "normal",
				assetId = getcustomasset("Minecraft.ttf") } },
		}))
		customFont = Font.new(getcustomasset("NovaMinecraft.json"))
	end
end)

local function applyFont(inst)
	if customFont then
		inst.FontFace = customFont
	else
		inst.Font = Enum.Font.Arcade
	end
end

