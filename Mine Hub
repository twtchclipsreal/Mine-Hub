local themed = {}
local function bindTheme(fn)
	themed[#themed + 1] = fn
	fn()
end
local function setTheme(p)
	theme.Accent, theme.Accent2 = p.a, p.b
	for _, fn in ipairs(themed) do pcall(fn) end
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do inst[k] = v end
	if className == "TextLabel" or className == "TextButton" then
		applyFont(inst)
		if props.TextStrokeTransparency == nil then
			inst.TextStrokeTransparency = 0.75
			inst.TextStrokeColor3 = Color3.new(0, 0, 0)
		end
		if props.TextTruncate == nil then inst.TextTruncate = Enum.TextTruncate.AtEnd end
	end
	inst.Parent = parent
	return inst
end

local function stroke(parent, color, thickness)
	return make("UIStroke", {
		Color = color, Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- Minecraft-style bevel: light top/left edge, dark bottom/right edge
local function bevel(parent, hi, lo, th)
	th = th or 2
	local function edge(size, pos, col)
		make("Frame", { Size = size, Position = pos, BackgroundColor3 = col, BorderSizePixel = 0 }, parent)
	end
	edge(UDim2.new(1, 0, 0, th), UDim2.fromOffset(0, 0), hi)
	edge(UDim2.new(0, th, 1, 0), UDim2.fromOffset(0, 0), hi)
	edge(UDim2.new(1, 0, 0, th), UDim2.new(0, 0, 1, -th), lo)
	edge(UDim2.new(0, th, 1, 0), UDim2.new(1, -th, 0, 0), lo)
end

local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(inst,
		TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

