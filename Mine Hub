local function toggle(page, label, desc, cb, initial)
	local r = row(page, desc and 44 or 32)
	local click = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	}, r)
	click.MouseEnter:Connect(function() tween(r, 0.1, { BackgroundColor3 = theme.SurfaceHi }) end)
	click.MouseLeave:Connect(function() tween(r, 0.1, { BackgroundColor3 = theme.Surface }) end)
	make("TextLabel", {
		Size = UDim2.new(1, -74, 0, 18), Position = UDim2.fromOffset(10, desc and 5 or 7),
		BackgroundTransparency = 1, Text = label,
		TextSize = 14, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	if desc then
		make("TextLabel", {
			Size = UDim2.new(1, -74, 0, 14), Position = UDim2.fromOffset(10, 25),
			BackgroundTransparency = 1, Text = desc,
			TextSize = 11, TextColor3 = theme.Muted, TextXAlignment = Enum.TextXAlignment.Left,
		}, r)
	end
	local sw = make("TextLabel", {
		Size = UDim2.fromOffset(46, 20), Position = UDim2.new(1, -56, 0.5, -10),
		BackgroundColor3 = theme.Off, Text = "OFF", TextSize = 12,
		TextColor3 = theme.Muted, BorderSizePixel = 0,
	}, r)
	stroke(sw, theme.Stroke, 2)

	local state = initial == true
	local function render(animate)
		sw.Text = state and "ON" or "OFF"
		sw.TextColor3 = state and Color3.fromRGB(85, 255, 85) or Color3.fromRGB(255, 85, 85)
	end
	bindTheme(function() render(false) end)

	click.Activated:Connect(function()
		state = not state
		render(true)
		local ok, err = pcall(cb, state)
		if not ok then
			warn("[MineHub] " .. label .. ": " .. tostring(err))
			state = false
			render(true)
			pcall(cb, false)
			notify("Error", label .. " failed", 3)
		end
	end)
end

local function slider(page, label, min, max, default, opts, cb)
	opts = opts or {}
	local decimals = opts.decimals or 0
	local suffix = opts.suffix or ""
	local r = row(page, 46)
	make("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 16), Position = UDim2.fromOffset(10, 5),
		BackgroundTransparency = 1, Text = label,
		TextSize = 13, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	local valueLbl = make("TextLabel", {
		Size = UDim2.new(0.4, -10, 0, 16), Position = UDim2.new(0.6, 0, 0, 5),
		BackgroundTransparency = 1, TextSize = 13,
		TextColor3 = theme.Accent, TextXAlignment = Enum.TextXAlignment.Right,
	}, r)
	bindTheme(function() valueLbl.TextColor3 = theme.Accent end)

	local bar = make("Frame", {
		Size = UDim2.new(1, -24, 0, 8), Position = UDim2.fromOffset(12, 28),
		BackgroundColor3 = theme.Off, BorderSizePixel = 0,
	}, r)
	stroke(bar, theme.Stroke, 1)
	local fill = make("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = theme.Accent, BorderSizePixel = 0,
	}, bar)
	bindTheme(function() fill.BackgroundColor3 = theme.Accent end)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(8, 18), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.fromRGB(200, 200, 205),
		BorderSizePixel = 0,
	}, bar)
	stroke(knob, theme.Stroke, 2)
	local hit = make("TextButton", {
		Size = UDim2.new(1, -10, 0, 22), Position = UDim2.fromOffset(5, 21),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	}, r)

	local value = default
	local function display(v)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		valueLbl.Text = string.format("%." .. decimals .. "f", v) .. suffix
	end
	display(default)

	local dragging, dragType = false, nil
	local function update(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local m = 10 ^ decimals
		local v = math.floor((min + a * (max - min)) * m + 0.5) / m
		if v ~= value then
			value = v
			display(v)
			pcall(cb, v)
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragType = true, input.UserInputType
			page.ScrollingEnabled = false
			update(input.Position.X)
		end
	end)
	track(UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			update(input.Position.X)
		end
	end))
	track(UIS.InputEnded:Connect(function(input)
		if dragging and input.UserInputType == dragType then
			dragging = false
			page.ScrollingEnabled = true
		end
	end))
end

