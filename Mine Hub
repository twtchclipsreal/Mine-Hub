local function makeDraggable(handle, target, onTap)
	local dragging, dragInput, startInput, startPos, moved
	track(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragInput = true, input
			startInput, startPos, moved = input.Position, target.Position, false
		end
	end))
	track(UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
			local d = input.Position - startInput
			if d.Magnitude > 6 then moved = true end
			if moved then
				target.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + d.X,
					startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end))
	track(UIS.InputEnded:Connect(function(input)
		if dragging and input.UserInputType == dragInput.UserInputType then
			dragging = false
			if not moved and onTap then onTap() end
		end
	end))
end
