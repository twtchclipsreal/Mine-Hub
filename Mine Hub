local tabs, tabOrder = {}, 0
local function selectTab(name)
	for n, t in pairs(tabs) do
		local on = (n == name)
		if on and not t.page.Visible then
			t.page.Position = UDim2.fromOffset(0, 10)
			tween(t.page, 0.28, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
		end
		t.page.Visible = on
		tween(t.btn, 0.12, { BackgroundColor3 = on and Color3.fromRGB(50, 50, 52) or theme.Surface })
		tween(t.lbl, 0.12, { TextColor3 = on and Color3.fromRGB(255, 255, 85) or theme.Text })
		t.bar.Visible = on
	end
end

local function addTab(name)
	tabOrder += 1
