		Size = UDim2.fromOffset(4, 18), Position = UDim2.new(0, 0, 0.5, -9),
		BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Visible = false,
	}, btn)
	bindTheme(function() bar.BackgroundColor3 = theme.Accent end)
	local lbl = make("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1, Text = name,
		TextSize = 13, TextColor3 = theme.Muted, TextXAlignment = Enum.TextXAlignment.Left,
	}, btn)
	tabs[name] = { page = page, btn = btn, lbl = lbl, bar = bar }
	btn.Activated:Connect(function() selectTab(name) end)
	return page
end

