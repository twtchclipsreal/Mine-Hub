-- Grass-block logo (4x4 pixels). Top rows follow the accent colour.
local DIRT = {
	Color3.fromRGB(134, 96, 67), Color3.fromRGB(121, 85, 58),
	Color3.fromRGB(150, 108, 74), Color3.fromRGB(104, 72, 48),
}
local function buildLogo(parent)
	local root = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, parent)
	local cells = {}
	local rng = Random.new(7)
	for r = 1, 4 do
		for c = 1, 4 do
			local isGrass = (r == 1) or (r == 2 and (c == 1 or c == 3))
			local cell = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale((c - 0.5) / 4, (r - 0.5) / 4),
				Size = UDim2.fromScale(0.25, 0.25), BorderSizePixel = 0,
				BackgroundColor3 = DIRT[rng:NextInteger(1, 4)],
			}, root)
			if isGrass then
				local odd = (r + c) % 2 == 0
				bindTheme(function() cell.BackgroundColor3 = odd and theme.Accent or theme.Accent2 end)
			end
			cells[#cells + 1] = cell
		end
	end
	return { root = root, cells = cells }
end

