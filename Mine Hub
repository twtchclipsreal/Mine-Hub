S.clickTp, S.light, S.freeze, S.frozen = false, false, false, false
local lightObj, fpsSaved

local function stepExtras()
	local root = getRoot()
	if S.light and root then
		if not lightObj or lightObj.Parent ~= root then
			if lightObj then lightObj:Destroy() end
			lightObj = make("PointLight", { Name = "NovaLight", Range = 60, Brightness = 2 }, root)
		end
	elseif lightObj then
		lightObj:Destroy()
		lightObj = nil
	end
	if root then
		if S.freeze then
			root.Anchored = true
			S.frozen = true
		elseif S.frozen then
			root.Anchored = false
			S.frozen = false
		end
	end
end

local function setFpsBoost(on)
	if on then
		if not fpsSaved then
			fpsSaved = { shadows = Lighting.GlobalShadows }
			pcall(function() fpsSaved.quality = settings().Rendering.QualityLevel end)
		end
		Lighting.GlobalShadows = false
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
	elseif fpsSaved then
		Lighting.GlobalShadows = fpsSaved.shadows
		if fpsSaved.quality then
			pcall(function() settings().Rendering.QualityLevel = fpsSaved.quality end)
		end
		fpsSaved = nil
	end
end

local function doTeleport(vp)
	local cam, root = workspace.CurrentCamera, getRoot()
	if not cam or not root then return end
	local ray = cam:ViewportPointToRay(vp.X, vp.Y)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { player.Character }
	params.FilterType = Enum.RaycastFilterType.Exclude
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	if hit then root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 4, 0)) end
end

local tapStart = {}
track(UIS.InputBegan:Connect(function(input, gp)
	if gp or not S.clickTp then return end
	if input.UserInputType == Enum.UserInputType.Touch then
		tapStart[input] = { Vector2.new(input.Position.X, input.Position.Y), os.clock() }
	elseif input.UserInputType == Enum.UserInputType.MouseButton1
		and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
		doTeleport(UIS:GetMouseLocation())
	end
end))
track(UIS.InputEnded:Connect(function(input)
	local st = tapStart[input]
	if not st then return end
	tapStart[input] = nil
	local p = Vector2.new(input.Position.X, input.Position.Y)
	if S.clickTp and (p - st[1]).Magnitude < 12 and os.clock() - st[2] < 0.25 then
		doTeleport(p + GuiService:GetGuiInset())
	end
end))

track(UIS.JumpRequest:Connect(function()
	if not S.infJump then return end
	local hum = getHumanoid()
	if hum and hum.Health > 0 then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end))

track(RunService.Heartbeat:Connect(function()
	stepOverrides()
	stepFly()
	stepExtras()
end))
track(RunService.Stepped:Connect(stepNoclip))

track(player.CharacterAdded:Connect(function()
	noclipTouched = {}
	for _, o in pairs(overrides) do
		if o.perChar then o.saved = nil end
	end
end))

