	end

	local function overrideTool(page, label, desc, key, min, max, default, opts)
		toggle(page, label, desc, function(on) setOverride(key, on) end)
		slider(page, label .. " Value", min, max, default, opts, function(v) setOverrideValue(key, v) end)
	end

	local function effectTool(page, label, desc, class, name, sliders)
		local vals = {}
		for _, sl in ipairs(sliders) do vals[sl.prop] = sl.default end
		local inst
		toggle(page, label, desc, function(on)
			if on then
				if inst then inst:Destroy() end
				inst = make(class, vals, Lighting)
				inst.Name = name
			elseif inst then
				inst:Destroy()
				inst = nil
			end
		end)
		onCleanup(function() if inst then inst:Destroy() end end)
		for _, sl in ipairs(sliders) do
			slider(page, sl.label, sl.min, sl.max, sl.default, sl.opts, function(v)
				vals[sl.prop] = v
