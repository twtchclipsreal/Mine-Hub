local function notify(title, text, dur)
	if not alive then return end
	local n = make("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0, GroupTransparency = 1,
	}, notifyHolder)
	stroke(n, theme.Stroke, 2)
	bevel(n, theme.BevelHi, theme.BevelLo)
	local bar = make("Frame", {
		Size = UDim2.new(0, 5, 1, 0), BackgroundColor3 = theme.Accent, BorderSizePixel = 0,
	}, n)
	bindTheme(function() bar.BackgroundColor3 = theme.Accent end)
	make("TextLabel", {
		Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(14, 7),
		BackgroundTransparency = 1, Text = title,
		TextSize = 14, TextColor3 = Color3.fromRGB(255, 255, 85), TextXAlignment = Enum.TextXAlignment.Left,
	}, n)
	make("TextLabel", {
		Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(14, 28),
		BackgroundTransparency = 1, Text = text,
		TextSize = 12, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
	}, n)
	tween(n, 0.25, { GroupTransparency = 0 })
	task.delay(dur or 2.5, function()
		if not n.Parent then return end
		tween(n, 0.25, { GroupTransparency = 1 })
		task.wait(0.3)
		if n.Parent then n:Destroy() end
	end)
end

