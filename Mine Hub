-- JUMP BUTTON (always shown on touch; toggle in Misc)
-- =========================================================
do
	-- Works even in games that block normal jumping: re-enables the Jumping state
	-- and applies the jump velocity directly.
	function S.doJump(isPress)
		local hum, root = getHumanoid(), getRoot()
		if not hum or not root or hum.Health <= 0 then return end
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
		if hum.Sit then hum.Sit = false end
		hum.Jump = true
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		if grounded or (S.infJump and isPress) then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
			local power = hum.UseJumpPower and hum.JumpPower
				or math.sqrt(2 * workspace.Gravity * hum.JumpHeight)
			local v = root.AssemblyLinearVelocity
			if v.Y < power * 0.5 then
				root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
			end
		end
	end

	local jumpFrame = make("Frame", {
		Name = "NovaJump", Size = UDim2.fromOffset(80, 80), AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -28, 1, -18), BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0, ZIndex = 200, Visible = true,
	}, screen)
	stroke(jumpFrame, theme.Stroke, 3)
	bevel(jumpFrame, theme.BevelHi, theme.BevelLo, 3)
	local jBtn = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "JUMP", ZIndex = 61,
		TextSize = 16, TextColor3 = Color3.fromRGB(255, 255, 85), AutoButtonColor = false,
	}, jumpFrame)
	local function isPress(i)
		return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
	end
	jBtn.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		S.jumpHeld = true
		S.doJump(true)
		tween(jumpFrame, 0.08, { BackgroundColor3 = theme.SurfaceHi })
	end)
	jBtn.InputEnded:Connect(function(input)
		if not isPress(input) then return end
		S.jumpHeld = false
		tween(jumpFrame, 0.08, { BackgroundColor3 = theme.Surface })
	end)
	track(RunService.Heartbeat:Connect(function()
		if S.jumpHeld then S.doJump(false) end
	end))
	toggle(pMisc, "Jump Button", "On-screen jump button",
		function(on) jumpFrame.Visible = on end, true)
end

