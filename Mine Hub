-- INTRO (Minecraft loading screen style)
-- =========================================================
-- Blocky stone-letter title (original pixel lettering, not the official Minecraft logo)
local GLYPHS = {
	M = {"10001","11011","10101","10001","10001"},
	I = {"11111","00100","00100","00100","11111"},
	N = {"10001","11001","10101","10011","10001"},
	E = {"11111","10000","11110","10000","11111"},
	H = {"10001","10001","11111","10001","10001"},
	U = {"10001","10001","10001","10001","01110"},
	B = {"11110","10001","11110","10001","11110"},
}
local function buildBlockTitle(parent, text, px, position)
	local gap, space = 1, 3
	local totalCells = 0
	for i = 1, #text do
		totalCells += (text:sub(i, i) == " ") and space or (5 + gap)
	end
	totalCells -= gap
	local root = make("Frame", {
		Size = UDim2.fromOffset(totalCells * px + 4, 5 * px + 4), Position = position,
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
	}, parent)
	local rng = Random.new(11)
	local stone = {
		Color3.fromRGB(150, 150, 150), Color3.fromRGB(135, 135, 135),
		Color3.fromRGB(165, 165, 165), Color3.fromRGB(120, 120, 120),
	}
	local letters, x = {}, 0
	for i = 1, #text do
		local ch = text:sub(i, i)
		if ch == " " then
			x += space
		else
			local g = GLYPHS[ch]
			local lf = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, root)
			-- shadows first, then stone cells on top
			for r = 1, 5 do
				for c = 1, 5 do
					if g[r]:sub(c, c) == "1" then
						make("Frame", {
							Size = UDim2.fromOffset(px, px),
							Position = UDim2.fromOffset((x + c - 1) * px + 4, (r - 1) * px + 4),
							BackgroundColor3 = Color3.fromRGB(30, 30, 30), BorderSizePixel = 0,
						}, lf)
					end
				end
			end
			for r = 1, 5 do
				for c = 1, 5 do
					if g[r]:sub(c, c) == "1" then
						local cell = make("Frame", {
							Size = UDim2.fromOffset(px, px),
							Position = UDim2.fromOffset((x + c - 1) * px, (r - 1) * px),
							BackgroundColor3 = stone[rng:NextInteger(1, 4)], BorderSizePixel = 0,
						}, lf)
						stroke(cell, Color3.fromRGB(20, 20, 20), 1)
						make("Frame", {
							Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.fromRGB(205, 205, 205),
							BorderSizePixel = 0,
						}, cell)
					end
				end
			end
			lf.Visible = false
			letters[#letters + 1] = lf
			x += 5 + gap
		end
	end
	return letters
end

