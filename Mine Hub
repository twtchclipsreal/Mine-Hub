	-- Per-frame logic
	local sprinting, sprintBase, lastSafe, zoomPrev
	local lastHop = 0
	local statAcc, fpsEMA = 0, 60
	track(RunService.Heartbeat:Connect(function(dt)
		local hum, root = getHumanoid(), getRoot()
		fpsEMA = fpsEMA + (1 / math.max(dt, 1e-3) - fpsEMA) * 0.1
		if hum and root then
			if S.sprint and UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
				if not sprinting then
					sprinting = true
					sprintBase = hum.WalkSpeed
				end
				hum.WalkSpeed = sprintBase * S.sprintMult
			elseif sprinting then
				sprinting = false
				hum.WalkSpeed = sprintBase
			end
			if S.bhop and hum.FloorMaterial ~= Enum.Material.Air
				and (UIS:IsKeyDown(Enum.KeyCode.Space) or hum.Jump or S.jumpHeld)
				and os.clock() - lastHop > 0.3 then
				lastHop = os.clock()
				if S.doJump then S.doJump(true) else hum.Jump = true end
				local look = root.CFrame.LookVector
				local dir = Vector3.new(look.X, 0, look.Z)
				if dir.Magnitude > 0.01 then
					dir = dir.Unit
					local params = RaycastParams.new()
					params.FilterDescendantsInstances = { player.Character }
					params.FilterType = Enum.RaycastFilterType.Exclude
					local hit = workspace:Raycast(root.Position, dir * (S.hopDist + 1), params)
					local dist = hit and math.max(hit.Distance - 1.5, 0) or S.hopDist
					root.CFrame = root.CFrame + dir * dist
				end
			end
			if S.spin and not S.fly then
				root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.spinSpeed) * dt, 0)
			end
			if S.antiVoid then
				local floorY = workspace.FallenPartsDestroyHeight
				if hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > floorY + 50 then
					lastSafe = root.CFrame
				elseif lastSafe and root.Position.Y < floorY + 30 then
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = lastSafe + Vector3.new(0, 4, 0)
				end
			end
		end
		statAcc += dt
		if statsOn and statAcc >= 0.2 then
			statAcc = 0
			local spd, pos = 0, Vector3.zero
			if root then
				local v = root.AssemblyLinearVelocity
				spd = Vector3.new(v.X, 0, v.Z).Magnitude
				pos = root.Position
			end
			local ping = 0
			pcall(function() ping = math.floor(player:GetNetworkPing() * 1000) end)
			statsBox.Text = ("SPD  %.1f\nPOS  %d, %d, %d\nPING %d ms  FPS %d"):format(
				spd, math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z),
				ping, math.floor(fpsEMA + 0.5))
		end
	end))

	track(RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then return end
		if S.zoomHold and UIS:IsKeyDown(Enum.KeyCode.C) then
			if not zoomPrev then zoomPrev = cam.FieldOfView end
			cam.FieldOfView = cam.FieldOfView + (S.zoomFov - cam.FieldOfView) * 0.25
		elseif zoomPrev then
			cam.FieldOfView = cam.FieldOfView + (zoomPrev - cam.FieldOfView) * 0.25
			if math.abs(cam.FieldOfView - zoomPrev) < 0.5 then
				cam.FieldOfView = zoomPrev
				zoomPrev = nil
			end
		end
	end))

	onCleanup(function()
		S.sprint, S.bhop, S.spin, S.antiVoid, S.zoomHold = false, false, false, false, false
		statsOn = false
		local hum = getHumanoid()
		if sprinting and hum then hum.WalkSpeed = sprintBase end
		if autoJumpOrig ~= nil and hum then hum.AutoJumpEnabled = autoJumpOrig end
	end)

	for i, n in ipairs({ "Player", "Movement", "Visuals", "Camera", "Graphics", "HUD", "Misc", "Settings" }) do
		if tabs[n] then tabs[n].btn.LayoutOrder = i end
	end
end
