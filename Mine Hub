local S = { infJump = false, noclip = false, fly = false, flySpeed = 60 }
local flyBV, flyGyro
local flyVel = Vector3.zero
local noclipTouched = {}
local savedLighting, savedAtmosphere

local function getHumanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local overrides = {
	speed = { perChar = true, value = 50,
		read  = function() local h = getHumanoid(); return h and h.WalkSpeed end,
		write = function(v) local h = getHumanoid(); if h then h.WalkSpeed = v end end },
	jump = { perChar = true, value = 100,
		read  = function() local h = getHumanoid(); return h and h.JumpPower end,
		write = function(v) local h = getHumanoid(); if h then h.UseJumpPower = true; h.JumpPower = v end end },
	gravity = { value = 196.2,
		read  = function() return workspace.Gravity end,
		write = function(v) workspace.Gravity = v end },
	fov = { value = 90,
		read  = function() local c = workspace.CurrentCamera; return c and c.FieldOfView end,
		write = function(v) local c = workspace.CurrentCamera; if c then c.FieldOfView = v end end },
	time = { value = 14,
		read  = function() return Lighting.ClockTime end,
		write = function(v) Lighting.ClockTime = v end },
}

local function stepOverrides()
	for _, o in pairs(overrides) do
		pcall(function()
			if o.on then
				local cur = o.read()
				if cur ~= nil then
					if o.saved == nil then o.saved = cur end
					if math.abs(cur - o.value) > 1e-3 then o.write(o.value) end
				end
			elseif o.saved ~= nil then
				o.write(o.saved)
				o.saved = nil
			end
		end)
	end
end

local function setOverride(key, on) overrides[key].on = on end
local function setOverrideValue(key, v) overrides[key].value = v end

local function stopFly()
	if flyBV then flyBV:Destroy(); flyBV = nil end
	if flyGyro then flyGyro:Destroy(); flyGyro = nil end
	if S.flyActive then
		local hum = getHumanoid()
		if hum then
			hum.PlatformStand = false
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
		S.flyActive = false
	end
	flyVel = Vector3.zero
end

local function stepFly()
	if S.flyPad then S.flyPad.Visible = S.fly end
	if not S.fly then
		stopFly()
		return
	end
	local root, hum = getRoot(), getHumanoid()
	if not root or not hum or hum.Health <= 0 then return end

	if not flyBV or flyBV.Parent ~= root then
		if flyBV then flyBV:Destroy() end
		flyBV = make("BodyVelocity", {
			Name = "NovaFly", MaxForce = Vector3.new(1e6, 1e6, 1e6), Velocity = Vector3.zero,
		}, root)
	end
	if not flyGyro or flyGyro.Parent ~= root then
		if flyGyro then flyGyro:Destroy() end
		flyGyro = make("BodyGyro", {
			Name = "NovaGyro", MaxTorque = Vector3.new(1e6, 1e6, 1e6), P = 1e4, D = 500,
			CFrame = root.CFrame,
		}, root)
	end
	hum.PlatformStand = true
	S.flyActive = true

	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)

	local speed = S.flySpeed
	local move = hum.MoveDirection
	local target = Vector3.zero
	if move.Magnitude > 0.05 then
		local fwd = move:Dot(flat)
		target = move * speed + Vector3.new(0, look.Y * math.max(fwd, 0) * speed, 0)
	end
	if UIS:IsKeyDown(Enum.KeyCode.Space) or S.flyUp then target += Vector3.new(0, speed, 0) end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or S.flyDown then target -= Vector3.new(0, speed, 0) end

	flyVel = flyVel:Lerp(target, 0.3)
	flyBV.Velocity = flyVel
	flyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
end

local function setNoclip(on)
	S.noclip = on
	if not on then
		for p in pairs(noclipTouched) do
			if p.Parent then p.CanCollide = true end
		end
		noclipTouched = {}
	end
end

local function stepNoclip()
	if not S.noclip then return end
	local char = player.Character
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") and p.CanCollide then
			noclipTouched[p] = true
			p.CanCollide = false
		end
	end
end

local function setFullbright(on)
	if on then
		if not savedLighting then
			savedLighting = {
				Brightness     = Lighting.Brightness,
				Ambient        = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				FogEnd         = Lighting.FogEnd,
				GlobalShadows  = Lighting.GlobalShadows,
			}
			savedAtmosphere = {}
			for _, v in ipairs(Lighting:GetChildren()) do
				if v:IsA("Atmosphere") then
					savedAtmosphere[v] = { Density = v.Density, Haze = v.Haze }
				end
			end
		end
		Lighting.Brightness     = 2
		Lighting.Ambient        = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.FogEnd         = 1e6
		Lighting.GlobalShadows  = false
		for atm in pairs(savedAtmosphere) do
			atm.Density = 0
			atm.Haze = 0
		end
	elseif savedLighting then
		for k, v in pairs(savedLighting) do
			pcall(function() Lighting[k] = v end)
		end
		for atm, props in pairs(savedAtmosphere or {}) do
			if atm.Parent then atm.Density = props.Density; atm.Haze = props.Haze end
		end
		savedLighting, savedAtmosphere = nil, nil
	end
end

local afkConn
local function setAntiAfk(on)
	if afkConn then afkConn:Disconnect(); afkConn = nil end
	if on then
		afkConn = player.Idled:Connect(function()
			pcall(function()
				VirtualUser:CaptureController()
